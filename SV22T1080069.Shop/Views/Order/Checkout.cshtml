@model SV22T1080069.Shop.Models.CheckoutViewModel

 <!-- ##### Breadcrumb Area Start ##### -->
<div class="breadcrumb-area">
    <!-- Top Breadcrumb Area -->
    <div class="top-breadcrumb-area bg-img bg-overlay d-flex align-items-center justify-content-center" 
    style="background-image: url(@Url.Content("~/assets/img/bg-img/3b.jpg")); ">
        <h2>Thanh toán</h2>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="#"><i class="fa fa-home"></i> Trang chủ</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<!-- ##### Breadcrumb Area End ##### -->
<!-- ##### Checkout Area Start ##### -->
<div class="checkout_area mb-100">
    <div class="container">
        <div class="row justify-content-between">
            <!-- Cột trái: Thông tin & thanh toán -->
            <div class="col-12 col-lg-6">
                <div class="checkout_details_area clearfix">
                    <h5 class="mb-3">THÔNG TIN THANH TOÁN</h5>

                    <form asp-action="Checkout" method="post" id="checkoutForm">
                        @Html.AntiForgeryToken()
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Họ và tên</label>
                                <input type="text" name="CustomerName" class="form-control"
                                       value="@Model.CustomerName">
                            </div>
                            <div class="form-group col-md-6">
                                <label>Tên liên hệ</label>
                                <input type="text" name="ContactName" class="form-control"
                                       value="@Model.ContactName">
                            </div>
                            <div class="form-group col-md-6">
                                <label>Số điện thoại</label>
                                <input type="text" name="Phone" class="form-control"
                                       value="@Model.Phone">
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="Email" class="form-control" readonly
                                   value="@Model.Email">
                        </div>

                        <div class="form-group">
                            <label>Tỉnh/Thành phố</label>
                            @Html.DropDownList(
                            "Province",
                             (IEnumerable<SelectListItem>)ViewBag.Provinces,
                              new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label>Địa chỉ</label>
                            <input type="text" name="Address" class="form-control"
                                   value="@Model.Address">
                        </div>

                        <!-- Nhóm phương thức thanh toán -->
                        <div class="mt-4">
                            <h5 class="mb-2">PHƯƠNG THỨC THANH TOÁN</h5>

                            <div class="list-group payment-method-list">
                                <!-- COD mặc định -->
                                <label class="list-group-item d-flex align-items-center py-2">
                                    <input class="form-check-input mr-2" type="radio"
                                           name="PaymentMethod" value="COD" checked>
                                    <div class="small">
                                        <div class="font-weight-bold">Thanh toán khi nhận hàng (COD)</div>
                                        <div>Thanh toán tiền mặt cho nhân viên giao hàng.</div>
                                    </div>
                                </label>

                                <!-- ZaloPay -->
                                <label class="list-group-item d-flex align-items-center py-2">
                                    <input class="form-check-input mr-2" type="radio"
                                           name="PaymentMethod" value="ZALOPAY">
                                    <div class="small">
                                        <div class="font-weight-bold">ZaloPay</div>
                                        <div>Thanh toán qua ví ZaloPay, quét mã QR / app.</div>
                                    </div>
                                </label>

                                <!-- VNPay -->
                                <label class="list-group-item d-flex align-items-center py-2">
                                    <input class="form-check-input mr-2" type="radio"
                                           name="PaymentMethod" value="VNPAY">
                                    <div class="small">
                                        <div class="font-weight-bold">VNPay</div>
                                        <div>Thanh toán qua cổng VNPay (thẻ ATM, ngân hàng, QR).</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- Nút đặt hàng cho mobile -->
                        <div class="mt-4 d-block d-lg-none">
                            <button type="submit" class="btn alazea-btn w-100">
                                ĐẶT HÀNG
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Cột phải: Đơn hàng của bạn (sticky) -->
            <div class="col-12 col-lg-6">
                <div class="checkout-content sticky-order">
                    <h5 class="title-- mb-3">ĐƠN HÀNG CỦA BẠN</h5>

                    <div class="products">
                        <div class="products-data">
                            <h5 class="mb-3">Sản phẩm</h5>

                            @foreach (var item in Model.CartItems)
                            {
                                var imgUrl = ApplicationContext.ProductImagePath + item.Photo;
                                <div class="single-products d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="product-thumbnail mr-3">
                                            <img src="@imgUrl"
                                                 alt="@item.ProductName"
                                                 style="width:60px;height:60px;object-fit:cover;">
                                        </div>
                                        <div>
                                            <p class="mb-1">@item.ProductName</p>
                                            <small>x @item.Quantity</small>
                                        </div>
                                    </div>
                                    <h5 class="mb-0">@item.Total.ToString("N0") đ</h5>
                                </div>
                            }
                        </div>
                    </div>
                    @{
                        var subtotal = Model.CartItems.Sum(x => x.Total);
                    }
                    <div class="subtotal d-flex justify-content-between align-items-center">
                        <h5>Tạm tính</h5>
                        <h5>@subtotal.ToString("N0") đ</h5>
                    </div>

                    <!-- Đã bỏ phí vận chuyển -->

                    <div class="order-total d-flex justify-content-between align-items-center">
                        <h5>Tổng cộng</h5>
                        <h5>@subtotal.ToString("N0") đ</h5>
                    </div>

                    <div class="checkout-btn mt-3 d-none d-lg-block">
                        <!-- Gắn với form bên trái bằng thuộc tính form -->
                        <button type="submit" form="checkoutForm" class="btn alazea-btn w-100">
                            ĐẶT HÀNG
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- ##### Checkout Area End ##### -->