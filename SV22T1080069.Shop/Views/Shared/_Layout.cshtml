    @{
        Layout = null;
    }
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

        <title>Hoa Mùa Hạ</title>

        <link rel="icon" href="~/assets/img/core-img/favicon.ico" />
        <link rel="stylesheet" href="~/assets/css/style.css" />
    </head>
    <body>
        <!-- Preloader -->
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-circle"></div>
            <div class="preloader-img">
                <img src="~/assets/img/core-img/leaf.png" alt="" />
            </div>
        </div>

        @{
            await Html.RenderPartialAsync("_Header");
        }

        @RenderBody()

        @{
            await Html.RenderPartialAsync("_Footer");
        }
   

        <!-- Scripts -->
        <script src="~/assets/js/jquery/jquery-2.2.4.min.js"></script>
        <script src="~/assets/js/bootstrap/popper.min.js"></script>
        <script src="~/assets/js/bootstrap/bootstrap.min.js"></script>
        <script src="~/assets/js/plugins/plugins.js"></script>
        <script src="~/assets/js/active.js"></script>
        @RenderSection("Scripts", required: false)
    <script>
                document.addEventListener('click', function (e) {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;

            e.preventDefault();

            const id = btn.dataset.id;
            console.log('Add to cart clicked, id =', id);

            fetch('/Cart/AddAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                },
                body: 'id=' + encodeURIComponent(id) + '&quantity=1'
            })
            .then(r => {
                console.log('Response status', r.status);
                if (!r.ok) throw new Error('Error ' + r.status);
                return r.json();
            })
            .then(data => {
                console.log('AddAjax result', data);
                if (data.success) {
                    const span = document.getElementById('cart-quantity');
                    if (span) span.textContent = '(' + data.totalQuantity + ')';
                     alert('Đã thêm sản phẩm vào giỏ hàng');
                }
            })
            .catch(err => console.error('AddAjax error', err));
        });
    </script>
    </body>
    </html>

