    @{
        Layout = null;
    }
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge" />
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

        <title>Hoa Mùa Hạ</title>

        <link rel="icon" href="~/assets/img/core-img/favicon.ico" />
        <link rel="stylesheet" href="~/assets/css/style.css" />
    </head>
    <body>
        <!-- Preloader -->
        <div class="preloader d-flex align-items-center justify-content-center">
            <div class="preloader-circle"></div>
            <div class="preloader-img">
                <img src="~/assets/img/core-img/leaf.png" alt="" />
            </div>
        </div>

        @{
            await Html.RenderPartialAsync("_Header");
        }

        @RenderBody()

        @{
            await Html.RenderPartialAsync("_Footer");
        }
   

        <!-- Scripts -->
        <script src="~/assets/js/jquery/jquery-2.2.4.min.js"></script>
        <script src="~/assets/js/bootstrap/popper.min.js"></script>
        <script src="~/assets/js/bootstrap/bootstrap.min.js"></script>
        <script src="~/assets/js/plugins/plugins.js"></script>
        <script src="~/assets/js/active.js"></script>
        @RenderSection("Scripts", required: false)
    <script>
        // true nếu đã đăng nhập, false nếu chưa (BOOLEAN)
        window.isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.textContent = message;
            toast.className = 'cart-toast ' +
                              (type === 'success' ? 'cart-toast--success' : 'cart-toast--error');
            document.body.appendChild(toast);

            void toast.offsetWidth;
            toast.classList.add('cart-toast--visible');

            setTimeout(() => {
                toast.classList.remove('cart-toast--visible');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.add-to-cart-btn, .btn.alazea-btn.ml-15');
            if (!btn) return;

            e.preventDefault();

            console.log('isAuthenticated =', window.isAuthenticated, typeof window.isAuthenticated);

            // Chưa đăng nhập: thông báo đỏ
            if (!window.isAuthenticated) {
                showToast('Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng', 'error');
                return;
            }

            const id = btn.dataset.id;

            // lấy số lượng: ưu tiên ô trên trang chi tiết, nếu không có thì mặc định 1
            let qtyInput = document.getElementById('detail-qty');
            let quantity = 1;
            if (qtyInput) {
                quantity = parseInt(qtyInput.value, 10) || 1;
            }

            fetch('/Cart/AddAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                },
                body: 'id=' + encodeURIComponent(id) +
                      '&quantity=' + encodeURIComponent(quantity)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    const span = document.getElementById('cart-quantity');
                    if (span) span.textContent = '(' + data.totalQuantity + ')';
                    showToast('Đã thêm sản phẩm vào giỏ hàng', 'success');
                } else {
                    showToast('Không thể thêm sản phẩm vào giỏ hàng', 'error');
                }
            })
            .catch(err => {
                console.error('AddAjax error', err);
                showToast('Có lỗi xảy ra, vui lòng thử lại', 'error');
            });
        });
    </script>

    </body>
    </html>

            @* window.isAuthenticated = @(User.Identity != null && User.Identity.IsAuthenticated ? "true" : "false"); *@