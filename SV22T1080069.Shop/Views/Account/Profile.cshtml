@model SV22T1080069.Shop.Models.CustomerProfileViewModel
@{
    var activeTab = ViewBag.ActiveTab as string ?? "info";
}

<!-- Profile Content -->
<div class="breadcrumb-area">
    <div class="top-breadcrumb-area bg-img bg-overlay d-flex align-items-center justify-content-center"
         style="background-image: url(@Url.Content("~/assets/img/bg-img/2b.png"));">
        <h2>TÀI KHOẢN CỦA TÔI</h2>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">><i class="fa fa-home"></i> Trang chủ</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Profile</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<section class="section-padding-100">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-12 col-md-4 col-lg-3">
                <div class="profile-sidebar">
                    <div class="profile-header text-center">
                        <div class="profile-avatar">
                            @{
                                string imgUrl = string.IsNullOrEmpty(Model.Photo)
                                ? ApplicationContext.CustomerImagePath + "nophoto.png"
                                : ApplicationContext.CustomerImagePath + Model.Photo;
                            }
                            <!-- Avatar: nếu Model.Photo rỗng thì dùng avatar default -->
                            <img src="@imgUrl"
                                 alt="Avatar">
                        </div>
                        <h5>@Model.CustomerName</h5>
                        <p class="text-muted">@Model.Email</p>
                    </div>

                    <!-- Menu dưới avatar: nav + icon -->
                    <ul class="profile-menu nav flex-column" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "info" ? "active" : "")" id="info-tab"
                               data-toggle="tab" href="#tab-info" role="tab"
                               aria-controls="tab-info" aria-selected="@(activeTab == "info")">
                                <span class="profile-menu-icon">
                                    <i class="fa fa-user"></i>
                                </span>
                                <span class="profile-menu-text">Thông tin cá nhân</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "orders" ? "active" : "")" id="orders-tab"
                               data-toggle="tab" href="#tab-orders" role="tab"
                               aria-controls="tab-orders" aria-selected="@(activeTab == "orders")">
                                <span class="profile-menu-icon">
                                    <i class="fa fa-shopping-bag"></i>
                                </span>
                                <span class="profile-menu-text">Đơn hàng của tôi</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(activeTab == "password" ? "active" : "")" id="password-tab"
                               data-toggle="tab" href="#tab-password" role="tab"
                               aria-controls="tab-password" aria-selected="@(activeTab == "password")">
                                <span class="profile-menu-icon">
                                    <i class="fa fa-lock"></i>
                                </span>
                                <span class="profile-menu-text">Đổi mật khẩu</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Logout", "Account")">
                                <span class="profile-menu-icon">
                                    <i class="fa fa-sign-out"></i>
                                </span>
                                <span class="profile-menu-text">Đăng xuất</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Content -->
            <div class="col-12 col-md-8 col-lg-9">
                <div class="tab-content profile-content">
                    <!-- Thông tin cá nhân -->
                    <div class="tab-pane fade @(activeTab == "info" ? "show active" : "")" id="tab-info"
                         role="tabpanel" aria-labelledby="info-tab">
                        <h4 class="mb-4">Thông tin cá nhân</h4>

                        @* Thông báo chung cho tab info (update profile) *@
                        @if (TempData["ProfileError"] != null && (activeTab == "info"))
                        {
                            <div class="alert alert-danger">
                                @TempData["ProfileError"]
                            </div>
                        }
                        @if (TempData["ProfileSuccess"] != null && (activeTab == "info"))
                        {
                            <div class="alert alert-success">
                                @TempData["ProfileSuccess"]
                            </div>
                        }


                        @using (Html.BeginForm("UpdateProfile", "Account",
                                                FormMethod.Post,
                                                new { enctype = "multipart/form-data", @class = "profile-form" }))
                        {
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Họ và tên</label>
                                    <input type="text" name="CustomerName" class="form-control"
                                           value="@Model.CustomerName">
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Tên liên hệ</label>
                                    <input type="text" name="ContactName" class="form-control"
                                           value="@Model.ContactName">
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Số điện thoại</label>
                                    <input type="text" name="Phone" class="form-control"
                                           value="@Model.Phone">
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" class="form-control"
                                       value="@Model.Email" disabled>
                            </div>

                            <div class="form-group">
                                <label>Tỉnh/Thành phố</label>
                                @Html.DropDownList(
                                "Province",
                                                        (IEnumerable<SelectListItem>)ViewBag.Provinces,
                                                        new { @class = "form-control" })
                        </div>



                            <div class="form-group">
                                <label>Địa chỉ</label>
                                <input type="text" name="Address" class="form-control"
                                       value="@Model.Address">
                            </div>

                            <div class="form-group">
                                <label>Ảnh đại diện</label>

                                <!-- Ảnh hiện tại / ảnh preview -->
                                <div class="mb-3">
                                    <img id="avatarPreview" src="@imgUrl" alt="User"
                                      style="width:120px;height:120px;object-fit:cover;border-radius:50%;border:1px solid #ddd;">
                            </div>

                                <!-- Input chọn file / Không dùng name="Avatar" nữa, để model binding tự nhận. -->
                                <input asp-for="UploadPhoto" type="file"class="form-control-file" id="AvatarInput" accept="image/*" />
                            </div>
                            <button type="submit" class="btn alazea-btn">Lưu thay đổi</button>
                                                }

                    </div>

                    <!-- Lịch sử đơn hàng -->
                    <div class="tab-pane fade @(activeTab == "orders" ? "show active" : "")" id="tab-orders"
                         role="tabpanel" aria-labelledby="orders-tab">
                        <h4 class="mb-4">Đơn hàng của tôi</h4>

                        @if (Model.Orders == null || !Model.Orders.Any())
                        {
                            <div class="alert alert-info">
                                Bạn chưa có đơn hàng nào. Hãy ghé cửa hàng và đặt thử một đơn nhé!
                            </div>
                        }
                        else
                        {
                            <div class="order-table-wrapper">
                                <div class="table-responsive">
                                    <table class="table table-striped order-table">
                                        <thead>
                                            <tr>
                                                <th>Mã đơn</th>
                                                <th>Ngày đặt</th>
                                                <th>Tổng tiền</th>
                                                <th>Trạng thái</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var orderVm in Model.Orders)
                                            {
                                                var order = orderVm.Order;

                                                <tr>
                                                    <td>#@order.OrderID</td>
                                                    <td>@order.OrderTime.ToString("dd/MM/yyyy")</td>
                                                    <td>@String.Format("{0:N0} VNĐ", orderVm.Total)</td>
                                                    <td>
                                                        <span class="badge badge-status status-@order.Status">
                                                            @order.StatusDescription
                                                        </span>
                                                    </td>
                                                    <td class="text-right">
                                                        <a href="@Url.Action("Details", "Order", new { id = order.OrderID })"
                                                           class="btn btn-sm btn-outline-secondary">
                                                            Chi tiết
                                                        </a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Đổi mật khẩu -->
                    <div class="tab-pane fade @(activeTab == "password" ? "show active" : "")" id="tab-password"
                         role="tabpanel" aria-labelledby="password-tab">
                        <h4 class="mb-4">Đổi mật khẩu</h4>

                        @if (TempData["ProfileError"] != null && (activeTab == "password"))
                        {
                            <div class="alert alert-danger">
                                @TempData["ProfileError"]
                            </div>
                        }
                        @if (TempData["ProfileSuccess"] != null && (activeTab == "password"))
                        {
                            <div class="alert alert-success">
                                @TempData["ProfileSuccess"]
                            </div>
                        }


                        @using (Html.BeginForm("ChangePassword", "Account",
                                                FormMethod.Post,
                                                new { @class = "profile-form" }))
                        {
                            <div class="form-group">
                                <label>Mật khẩu hiện tại</label>
                                <input type="password" name="oldPassword"
                                       class="form-control" required>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-6">
                                    <label>Mật khẩu mới</label>
                                    <input type="password" name="newPassword"
                                           class="form-control" required>
                                </div>
                                <div class="form-group col-md-6">
                                    <label>Nhập lại mật khẩu mới</label>
                                    <input type="password" name="confirmPassword"
                                           class="form-control" required>
                                </div>
                            </div>
                            <button type="submit" class="btn alazea-btn">Cập nhật mật khẩu</button>
                        }
                    </div>

                </div>
            </div>
            <!-- End Content -->
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const avatarInput = document.getElementById('AvatarInput');
        const avatarPreview = document.getElementById('avatarPreview');

        if (avatarInput) {
            avatarInput.addEventListener('change', function () {
                const file = this.files[0];
                if (!file) return;
                if (!file.type.startsWith('image/')) {
                    alert('Vui lòng chọn file hình ảnh');
                    this.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function (e) {
                    avatarPreview.src = e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }
    </script>
}
