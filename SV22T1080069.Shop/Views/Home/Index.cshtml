<section class="new-arrivals-products-area bg-gray section-padding-100">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <!-- Section Heading -->
                <div class="section-heading text-center">
                    <h2>NEW ARRIVALS</h2>
                    <p>We have the latest products, it must be exciting for you</p>
                </div>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var imgUrl = string.IsNullOrEmpty(item.Photo)
                    ? ApplicationContext.ProductImagePath + "nophoto.png"
                    : ApplicationContext.ProductImagePath + item.Photo;
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="single-product-area mb-50 wow fadeInUp" data-wow-delay="200ms">
                            <!-- Product Image -->
                            <div class="product-img">
                                <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })">
                                    @* <img src="~/images/products/@item.Photo" alt="@item.ProductName" /> *@
                                    <img src="@imgUrl" alt="@item.ProductName" />
                                </a>
                                <div class="product-meta d-flex">
                                    <a href="#" class="wishlist-btn"><i class="icon_heart_alt"></i></a>
                                    <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })"
                                       class="add-to-cart-btn">Thêm vào giỏ</a>
                                </div>
                            </div>
                            <!-- Product Info -->
                            <div class="product-info mt-15 text-center">
                                <a href="@Url.Action("Details", "Shop", new { id = item.ProductID })">
                                    <p>@item.ProductName</p>
                                </a>
                                <h6>@item.Price.ToString("N0") VNĐ</h6>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p>Hiện chưa có sản phẩm nào.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- ##### Product Area End ##### -->
