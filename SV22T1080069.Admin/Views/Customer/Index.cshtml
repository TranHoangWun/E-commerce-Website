
@model PaginationSearchCondition
<!-- IEnumerable<SV22T1080069.DomainModels.Customer>  PaginationSearchResult<Customer>-->
@{    
    ViewBag.Title = "Quản lý Khách hàng ";
}
<div class="box box-primary">
    <div class="box-body">
        <!-- Form để nhập đầu vào tìm kiếm -->
        @* <form id="formSearch" action="~/Customer" method="get"> *@
        <form id="formSearch" action="~/Customer/Search" method="get" data-result="#searchResult">
            <div class="input-group">
                <input type="hidden" asp-for="PageSize" />
                @* <input name="searchValue"  *@
                <input type="text"
                        class="form-control"
                        placeholder="Nhập tên khách hàng cần tìm"
                        autofocus
                       asp-for="SearchValue" />
                        @* value="@Model.SearchValue"/> *@
                        

                <div class="input-group-btn">
                    <button class="btn btn-info" type="submit">
                        <i class="fa fa-search"></i>
                    </button>

                    <a href="~/Customer/Create" class="btn btn-primary" style="margin-left:5px">
                        <i class="fa fa-plus"></i> Bổ sung
                    </a>
                </div>
            </div>
        </form>
        <!-- Hiển thị dữ liệu -->
        <div id="searchResult"></div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function(){
            $("#formSearch").submit(function (e) {
                e.preventDefault();
                searchData(1);
            });
             searchData(@Model.Page);
            //searchData(1);
        })

        //Gởi yêu cầu đến Search để lấy dữ liệu tại trang page, hiển thị dữ liệu vào #searchResult
        function searchData(page) {

            var url = $("#formSearch").prop("action");
            var method = $("#formSearch").prop("method");
            var container = $("#formSearch").data("result");
            var submitData = $("#formSearch").serializeArray();
            submitData.push({ "name":"page", "value": page });

            $.ajax({
                url: url,
                method: method,
                data: submitData,
                success: function (data) {
                    $(container).html(data);
                }
            });
        }
    </script>
}
