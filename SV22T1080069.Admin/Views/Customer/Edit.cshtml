@model Customer
@{

}
<div class="box box-primary">
    <div class="box-body">
        <form action="~/Customer/SaveData" method="post">         
            <input type="hidden" name="@nameof(Model.CustomerID)" value="@Model.CustomerID"/>
            <div class="form-group">
                <label>Tên khách hàng:</label>
                <input type="text" class="form-control" autofocus name="@nameof(Model.CustomerName)" value="@Model.CustomerName" />
                <span asp-validation-for="CustomerName"></span>
                @* <input type="text" class="form-control" autofocus asp-for="CustomerName" /> *@
            </div>

            <div class="form-group">
                <label>Tên giao dịch:</label>
                <input type="text" class="form-control" name="@nameof(Model.ContactName)" value="@Model.ContactName" />
                <span asp-validation-for="ContactName"></span>
            </div>

            <div class="form-group">
                <label>Điện thoại:</label>
                <input type="text" class="form-control" name="@nameof(Model.Phone)" value="@Model.Phone" />
                @Html.ValidationMessageFor(model => model.Phone)
            </div>

            <div class="form-group">
                <label>Email:</label>
                <input type="text" class="form-control" name="@nameof(Model.Email)" value="@Model.Email" />
                @Html.ValidationMessage(nameof(Model.Email))
            </div>

            <div class="form-group">
                <label>Địa chỉ:</label>
                <input type="text" class="form-control" name="@nameof(Model.Address)" value="@Model.Address" />
                <span asp-validation-for="Address"></span>
            </div>

            <div class="form-group">
                <label>Tỉnh/thành:</label>
                <select class="form-control select2" asp-for="Province" asp-items="await SelectListHelper.Provinces()"></select>
                @* <select class="form-control" name="@nameof(Model.Province)" value="@Model.Province"> *@

                @*     <option value="">-- Chọn Tỉnh/thành</option>
                    @foreach (var province in await SV22T1080069.BusinessLayers.CommonDataService.ProvinceDB.ListAsync())
                    {
                        if (province.ProvinceName == Model.Province)
                        {
                            <option value="@province.ProvinceName" selected>@province.ProvinceName</option>
                        }
                        else
                        {
                            <option value="@province.ProvinceName">@province.ProvinceName</option>
                        }
                    }
                    <option value="">-- Chọn Tỉnh/thành:</option>
                    <option value="Thừa Thiên Huế">Thừa Thiên Huế</option>
                    <option value="Quảng Trị">Quảng Trị</option>
                </select> *@
                <span asp-validation-for="Province"></span>
            </div>

            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input type="checkbox" 
                           value="true" 
                           name="@nameof(Model.IsLocked)"
                               @(Model.IsLocked ? "checked" : "") /> 
                               Khóa tài khoản khách hàng
                    </label>
                </div>
            </div>           
            <div class="form-group">
                @Html.ValidationMessage("Error");
            </div>
            <div class="form-group text-right">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-floppy-o"></i>
                    Lưu dữ liệu
                </button>
                <a href="~/Customer" class="btn btn-default">
                    Quay lại
                </a>
            </div>

        </form>
    </div>
</div>